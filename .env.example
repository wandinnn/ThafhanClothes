APP_NAME=ThafhanClothes
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Kredensial admin yang dipakai AdminUserSeeder.
# ADMIN_PASSWORD wajib diisi sebelum seeding di production.
ADMIN_EMAIL=admin@thafhanclothes.test
ADMIN_PASSWORD=

# Deadline flash sale (opsional). Format: 2026-08-10 23:59:59
FLASH_SALE_ENDS_AT=
SHOP_TIMEZONE=Asia/Jakarta

# Fase 3 — pembayaran & ongkir
# manual = transfer/QRIS + bukti (default)
# fake = tombol bayar simulasi (lokal/demo)
# midtrans = Snap Midtrans (butuh key di bawah)
# Bisa diganti juga dari Admin → Pengaturan → Metode Pembayaran
PAYMENT_DRIVER=manual
PAYMENT_EXPIRES_AFTER_HOURS=24
SHOP_BANK_NAME=Seabank
SHOP_BANK_ACCOUNT=901550812105
SHOP_BANK_HOLDER=NAUFAL THAFHAN

# Midtrans Snap (sandbox: https://dashboard.sandbox.midtrans.com)
# 1) Isi server + client key
# 2) Set PAYMENT_DRIVER=midtrans ATAU pilih Midtrans di Admin → Pengaturan
# 3) Daftarkan webhook: {APP_URL}/webhooks/midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# static = tarif flat per kota (default)
# fake = multi-kurir lokal tanpa API RajaOngkir
SHIPPING_DRIVER=static
SHIPPING_DEFAULT_WEIGHT_GRAMS=500

# Fase 4 — notifikasi email status (tanpa akun pembeli)
SHOP_WHATSAPP=6281324825060
SHOP_MAIL_NOTIFICATIONS=true
SHOP_MAIL_STATUS=true
SHOP_MAIL_SHIPMENT=true
SHOP_MAIL_PAYMENT_PROOF_CUSTOMER=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=onboarding@resend.dev
MAIL_FROM_NAME="${APP_NAME}"

# Catatan: onboarding@resend.dev hanya boleh mengirim ke email akun Resend Anda.
# Setelah punya domain terverifikasi, ganti MAIL_FROM_ADDRESS ke order@domainanda.com.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

MEILI_ENABLED=false
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=
MEILISEARCH_INDEX=products
